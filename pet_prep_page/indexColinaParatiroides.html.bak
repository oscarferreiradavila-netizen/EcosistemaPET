}
.btn-topbar-nav:hover {
  background: #ffffff;
  color: #004868;
  transform: translateY(-1px);
}
.topbar-dropdown-select {
  background: #ffffff;
  color: #00364e;
  font-weight: 700;
  font-size: 0.82rem;
  padding: 5px 10px;
  border-radius: 7px;
  border: 2px solid #007eb4;
  outline: none;
  cursor: pointer;
  max-width: 380px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.12);
}
.topbar-right-box {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}
.topbar-supplier-pill {
  font-size: 0.72rem;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 6px;
  background: #0284c7; color: #fff;
  white-space: nowrap;
}
.topbar-counter-pill {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  font-weight: 800;
  background: rgba(0, 0, 0, 0.3);
  color: #38bdf8;
  padding: 4px 10px;
  border-radius: 6px;
  border: 1px solid rgba(56, 189, 248, 0.4);
  white-space: nowrap;
}
@media (max-width: 900px) {
  .topbar-wrapper {
    flex-direction: column;
    align-items: stretch;
  }
  .topbar-nav-controls {
    justify-content: space-between;
  }
  .topbar-dropdown-select {
    max-width: 100%;
    flex: 1;
  }
}
</style>

<div class="audioguia-official-topbar">
  <div class="topbar-wrapper">
